# ==============================================================================
# ExamCraft AI - Environment Configuration (.env.example)
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY="django-insecure-replace-with-a-secure-random-secret-key-for-production"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0,ais-dev-ikuke36funk2nmbkk7xptp-748237559399.asia-southeast1.run.app"

# Database Configuration (Supabase PostgreSQL)
# Example connection string for Supabase:
# Session Pooler (port 5432) or Transaction Pooler (port 6543):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=""

# Direct connection parameters alternative (if DATABASE_URL is not set):
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD=""
DB_HOST=""
DB_PORT="5432"
DB_SSLMODE="require"

# JWT Authentication Settings
ACCESS_TOKEN_LIFETIME_MINUTES="60"
REFRESH_TOKEN_LIFETIME_DAYS="7"

# CORS Configuration
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# Google Gemini AI Integration (Backend only)
# Used for M4 AI Question Generation Engine
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Application URL
APP_URL="http://localhost:8000"

# M18 SMTP email delivery (in-app notifications work without SMTP).
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS="True"
EMAIL_USE_SSL="False"
DEFAULT_FROM_EMAIL=""
